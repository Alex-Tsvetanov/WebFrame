.vscode/
*.exe
**/*.exe
buffer.txt
log.txt
curl.txt
lib/Jinja2Cpp/**
cppcheck*.*
check_report.xml
node_modules/
bin/
benchmark/tmp/
package-lock.json
build*/
benchmark/benchmark.sh
debug.log
.cache/

# CTest scratch, written into the source directory when ctest runs from here rather
# than from a build directory. Generated, and it has been sitting untracked long
# enough to be noise in every git status.
Testing/

# Campaign output. Raw run records live with the paper that quotes them, not here, and
# an untracked results directory makes the tree dirty, which is a rejection criterion
# for every run in the campaign that produced it.
benchmark/results/

# Byte cache. tests/integration/protocol_demux.py and tls_demux.py now import a sibling
# module, so ctest leaves one of these beside them; an untracked directory there makes
# the tree dirty, which is a rejection criterion for every run in a campaign.
__pycache__/
*.pyc

# Finder metadata; an untracked file is a dirty tree to the validity gate
.DS_Store
