---
# readability-static-accessed-through-instance is OFF because it is broken on
# coroutines, not because the rule is unwanted.
#
# It fires on the declaration line of every out-of-line coroutine member definition,
# reporting a static member access that is not in the source. All 67 occurrences in
# this tree were false positives of that shape. Its --fix then rewrites those lines
# into nonsense: `ChunkedResponse::send_headers()` becomes
# `ChunkedResponse::std::coroutine_traits<...>::promise_type::send_headers()`.
# Verified on clang-tidy 22.1.0, where it silently corrupted 66 definitions across 9
# files before a rebuild caught it.
#
# Consequence: DO NOT run a blanket `clang-tidy --fix` over this codebase. The other
# checks fix cleanly, so pass an explicit --checks list and rebuild immediately after.
#
# Rationale for the non-obvious exclusions below. Note these must stay outside the
# Checks block scalar: inside it, '#' is not a comment, it becomes part of the string
# and silently breaks every entry that follows.
#
# Bounds-checking family
#   -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access
#   -cppcoreguidelines-pro-bounds-constant-array-index
# pro-bounds-pointer-arithmetic and pro-bounds-array-to-pointer-decay were already
# off, so leaving these two on was inconsistent rather than deliberate. They fire on
# every container operator[] and every non-constant array index, which in a protocol
# parser is every line that does work. ASan catches bounds errors from real indices
# instead of guessing from syntax.
#
# Coroutine lifetime family
#   -cppcoreguidelines-avoid-reference-coroutine-parameters
#   -cppcoreguidelines-avoid-capturing-lambda-coroutines
# Both fire on the framework's own middleware signature, Task<Response>(Request&,
# Next), and on the middleware factories that return capturing lambda coroutines. The
# hazard is real and is the main memory risk in this codebase, but it cannot be fixed
# without breaking the public API, and neither check can see that Request outlives the
# chain borrowing it. The asan preset is the instrument for this, not a static check.
Checks: >
  bugprone-*,
  cert-*,
  cppcoreguidelines-*,
  google-*,
  modernize-*,
  performance-*,
  readability-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-type-member-init,
  -cppcoreguidelines-special-member-functions,
  -google-runtime-int,
  -modernize-use-trailing-return-type,
  -readability-braces-around-statements,
  -readability-implicit-bool-conversion,
  -readability-redundant-string-init,
  -readability-isolate-declaration,
  -google-build-using-namespace,
  -cppcoreguidelines-owning-memory,
  -bugprone-narrowing-conversions,
  -cppcoreguidelines-narrowing-conversions,
  -bugprone-easily-swappable-parameters,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-convert-member-functions-to-static,
  -bugprone-branch-clone,
  -cppcoreguidelines-avoid-c-arrays,
  -modernize-avoid-c-arrays,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-avoid-reference-coroutine-parameters,
  -cppcoreguidelines-avoid-capturing-lambda-coroutines,
  -readability-static-accessed-through-instance

WarningsAsErrors: "*"

HeaderFilterRegex: 'include/coroute/.*'

CheckOptions:
  - key:             readability-identifier-naming.ClassCase
    value:           CamelCase
  - key:             readability-identifier-naming.StructCase
    value:           CamelCase
  - key:             readability-identifier-naming.EnumCase
    value:           CamelCase
  - key:             readability-identifier-naming.EnumConstantCase
    value:           CamelCase
  - key:             readability-identifier-naming.FunctionCase
    value:           lower_case
  - key:             readability-identifier-naming.VariableCase
    value:           lower_case
  - key:             readability-identifier-naming.GlobalVariableCase
    value:           lower_case
  - key:             readability-identifier-naming.ParameterCase
    value:           lower_case
  - key:             readability-identifier-naming.NamespaceCase
    value:           lower_case
  - key:             readability-identifier-naming.MemberCase
    value:           lower_case
  - key:             readability-identifier-naming.PrivateMemberSuffix
    value:           _
  - key:             readability-identifier-naming.ProtectedMemberSuffix
    value:           _
  - key:             google-readability-braces-around-statements.ShortIfThreshold
    value:           2
  - key:             modernize-use-auto.MinTypeNameLength
    value:           5
  - key:             performance-for-range-copy.WarnOnAllAutoCopies
    value:           true
...
