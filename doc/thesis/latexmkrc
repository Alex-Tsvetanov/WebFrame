# pdfLaTeX, НЕ XeLaTeX — вж. REQUIREMENTS.md Б.0 (T2A + tempora).
$pdf_mode = 1;
$bibtex_use = 2;
$out_dir = 'build';
$clean_ext = 'bbl nav out snm synctex.gz run.xml';
# main.pdf is versioned beside the source, so the build has to be reproducible. Without
# this, pdfTeX stamps CreationDate, ModDate and the file identifier with the moment of the
# build, so two builds of identical source differ in 68 bytes and every rebuild looks like a
# change. With three branches now carrying the PDF that is a merge conflict for nothing.
# The date comes from the last commit that touched a thesis SOURCE, not from HEAD and not
# from the clock: an unrelated commit elsewhere then leaves the PDF byte-identical, while a
# real edit moves the date once, together with the edit. generated/results.tex is not
# tracked and so cannot contribute a date; it does not need to, since a measurement change
# arrives with a data file that is.
my $epoch = `git log -1 --format=%ct -- Main.tex Abstract.tex preamble.tex lang.tex coroute.bib chapters abstract figures data images 2>/dev/null`;
chomp $epoch;
$ENV{SOURCE_DATE_EPOCH} = ($epoch =~ /^\d+$/) ? $epoch : time;
$ENV{FORCE_SOURCE_DATE} = 1;

# The entry point is Main.tex, capital M. Without this, a bare `latexmk` takes every .tex in
# the directory as its own document and fails on lang.tex and preamble.tex, which are inputs
# and not documents; the real thesis builds anyway, so the failure looks worse than it is.
@default_files = ('Main.tex');

# Capital M here too. macOS ignores filename case, so `build/main.pdf` resolves on this
# machine and nowhere else; on Linux latexmk writes build/Main.pdf and this copy silently
# fails, leaving the versioned PDF at whatever it was. That is the failure that looks like
# success, which is the kind this project refuses everywhere else.
$success_cmd = 'cp build/Main.pdf main.pdf';
